# -----------------------------------------------
# ----  EditorConfig  ---------------------------
# ----  https://editorconfig.org  ---------------
# -----------------------------------------------

root = true

[*]
end_of_line          = lf
insert_final_newline = true
charset              = utf-8
indent_style         = space
indent_size          = 2
tab_width            = 4
max_line_length      = 110
insert_final_newline = true

[Dockerfile]
indent_size          = 4

[Makefile]
indent_style         = tab

[*.conf]
indent_style         = tab

[*.sh]
indent_style         = space
shell_variant        = bash
binary_next_line     = true
switch_case_indent   = true
space_redirects      = false
keep_padding         = false
function_next_line   = true
