# -----------------------------------------------
# ----  EditorConfig  ---------------------------
# ----  https://editorconfig.org  ---------------
# -----------------------------------------------

root = true

[*]
end_of_line              = lf
insert_final_newline     = true
charset                  = utf-8
indent_style             = space
indent_size              = 2
tab_width                = 2
trim_trailing_whitespace = true

[*.sh]
shell_variant            = sh
binary_next_line         = true
switch_case_indent       = true
space_redirects          = false
keep_padding             = false
function_next_line       = true
